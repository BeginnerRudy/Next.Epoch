# Next.Epoch Configuration
# Copy this file to .env and update values as needed

# Application
NEXT_EPOCH_DEBUG=false
NEXT_EPOCH_ENVIRONMENT=development
NEXT_EPOCH_LOG_LEVEL=INFO

# API
NEXT_EPOCH_API_HOST=0.0.0.0
NEXT_EPOCH_API_PORT=8000
NEXT_EPOCH_API_KEY=your-api-key-here

# Database (PostgreSQL)
NEXT_EPOCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/next_epoch
NEXT_EPOCH_DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/next_epoch

# Redis (for caching)
NEXT_EPOCH_REDIS_URL=redis://localhost:6379/0

# LLM Configuration
NEXT_EPOCH_LLM_PROVIDER=openai
NEXT_EPOCH_LLM_MODEL=gpt-4o-mini
NEXT_EPOCH_LLM_API_KEY=your-llm-api-key-here

# Ingestion Settings
NEXT_EPOCH_ARXIV_MAX_RESULTS=100
NEXT_EPOCH_INGESTION_INTERVAL_MINUTES=60

# Scoring Settings
NEXT_EPOCH_RELEVANCE_THRESHOLD=0.3
NEXT_EPOCH_NOVELTY_ENABLED=false
